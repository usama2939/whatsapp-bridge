# WA Chat Bridge — gateway configuration
# Copy this file to `.env` and fill in the values.

# Port the gateway listens on.
PORT=3001

# Shared secret. MUST be identical to the "Shared secret" in
# WordPress → WA Chat → Settings. Used to authenticate calls in both directions.
AUTH_TOKEN=change-me-to-a-long-random-string

# Where the gateway posts your WhatsApp replies back into WordPress.
# Format: https://YOUR-SITE/wp-json/wacb/v1/incoming
WP_WEBHOOK_URL=https://your-site.com/wp-json/wacb/v1/incoming

# Optional: where Baileys stores the linked-device credentials.
# AUTH_DIR=./auth

# Optional log level (info | debug | silent)
# LOG_LEVEL=info
